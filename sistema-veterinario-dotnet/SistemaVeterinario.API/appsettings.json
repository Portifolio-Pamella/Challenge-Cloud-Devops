{
  "ConnectionStrings": {
    // ATENÇÃO: Substitua os valores em MAIÚSCULO pelos dados reais do seu banco
    // HOST: Endereço do servidor (ex: localhost, oracle.fiap.com.br ou IP da Azure)
    // PORT: Porta de comunicação (Padrão Oracle é 1521)
    // SERVICE_NAME: Nome do serviço Oracle (ex: ORCL, FREEPDB1, XEPDB1)
    // User Id: Seu usuário de acesso ao banco (ex: system, RM00000)
    // Password: Sua senha de acesso
    "OracleConnection": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=SEU_HOST_AQUI)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=SEU_SERVICO_AQUI)));User Id=SEU_USUARIO_AQUI;Password=SUA_SENHA_AQUI;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}