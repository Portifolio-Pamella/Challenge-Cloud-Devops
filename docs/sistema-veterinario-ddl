-- Criação da tabela TB_VETERINARIO
CREATE TABLE TB_VETERINARIO (
    ID_VETERINARIO NUMBER(10) NOT NULL,
    NOME_VETERINARIO VARCHAR2(150) NOT NULL,
    CRM_VETERINARIO VARCHAR2(50) NOT NULL,
    ESPECIALIDADE_VETERINARIO VARCHAR2(100) NOT NULL,
    TELEFONE_VETERINARIO VARCHAR2(20),
    EMAIL_VETERINARIO VARCHAR2(150),
    STATUS_VETERINARIO VARCHAR2(20),
    DATA_CADASTRO_VETERINARIO DATE,
    CONSTRAINT PK_TB_VETERINARIO PRIMARY KEY (ID_VETERINARIO),
    CONSTRAINT UK_VET_CRM UNIQUE (CRM_VETERINARIO),
    CONSTRAINT UK_VET_EMAIL UNIQUE (EMAIL_VETERINARIO)
);

-- Criação da tabela TB_TUTOR
CREATE TABLE TB_TUTOR (
    ID_TUTOR NUMBER(10) GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    NOME_TUTOR VARCHAR2(150) NOT NULL,
    CPF_TUTOR VARCHAR2(14) NOT NULL,
    TELEFONE_TUTOR VARCHAR2(20),
    EMAIL_TUTOR VARCHAR2(150) NOT NULL,
    CEP_TUTOR VARCHAR2(10) NOT NULL,
    RUA_TUTOR VARCHAR2(150) NOT NULL,
    NUMERO_TUTOR VARCHAR2(20) NOT NULL,
    COMPLEMENTO_TUTOR VARCHAR2(100),
    BAIRRO_TUTOR VARCHAR2(100) NOT NULL,
    CIDADE_TUTOR VARCHAR2(100) NOT NULL,
    ESTADO_TUTOR VARCHAR2(2) NOT NULL,
    DATA_CADASTRO_TUTOR DATE NOT NULL,
    CONSTRAINT PK_TB_TUTOR PRIMARY KEY (ID_TUTOR)
);

-- Criação da tabela TB_PET
CREATE TABLE TB_PET (
    ID_PET NUMBER(10) GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    ID_TUTOR NUMBER(10) NOT NULL,
    NOME_PET VARCHAR2(100) NOT NULL,
    ESPECIE_PET VARCHAR2(50) NOT NULL,
    RACA_PET VARCHAR2(50) NOT NULL,
    SEXO_PET VARCHAR2(20) NOT NULL,
    DATA_NASCIMENTO_PET DATE NOT NULL,
    PESO_PET NUMBER(5,2) NOT NULL,
    COR_PET VARCHAR2(50) NOT NULL,
    DATA_CADASTRO_PET DATE NOT NULL,
    CONSTRAINT PK_TB_PET PRIMARY KEY (ID_PET),
    CONSTRAINT FK_PET_TUTOR FOREIGN KEY (ID_TUTOR) 
        REFERENCES TB_TUTOR (ID_TUTOR) 
        ON DELETE RESTRICT
);